{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mindsnap",
  "version": "1.1.0-beta",
  "identifier": "com.mindsnap.desktop",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Mindsnap",
        "width": 920,
        "height": 660,
        "minWidth": 760,
        "minHeight": 530,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["appimage"],
    "publisher": "x0thra",
    "homepage": "https://github.com/x0thra/mindsnap",
    "copyright": "Copyright © 2026 x0thra",
    "license": "MIT",
    "category": "Utility",
    "shortDescription": "Mindsnap - Digital Awareness & Usage Breaker",
    "longDescription": "Mindsnap monitors continuous application usage, encouraging healthy digital habits and breaks.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  },
  "plugins": {}
}
